# ===========================================
# ProjectFlow Lab - Variables de Entorno
# Laboratorio OWASP A01:2025 (Broken Access Control)
# ===========================================

# Copiar este archivo a .env y ajustar los valores según el entorno

# ===========================================
# BASE DE DATOS (PostgreSQL 16)
# ===========================================
POSTGRES_USER=projectflow
POSTGRES_PASSWORD=ChangeMe_2026!Secure
POSTGRES_DB=projectflow_auth

# URLs de conexión para cada servicio
DATABASE_URL_AUTH=postgresql://projectflow:ChangeMe_2026!Secure@postgres:5432/projectflow_auth
DATABASE_URL_USERS=postgresql://projectflow:ChangeMe_2026!Secure@postgres:5432/projectflow_users
DATABASE_URL_PROJECTS=postgresql://projectflow:ChangeMe_2026!Secure@postgres:5432/projectflow_projects

# ===========================================
# REDIS 7 (Cache/Sessions)
# ===========================================
REDIS_PASSWORD=RedisSecret_2026!
REDIS_URL_AUTH=redis://:RedisSecret_2026!@redis:6379/0
REDIS_URL_USERS=redis://:RedisSecret_2026!@redis:6379/1
REDIS_URL_PROJECTS=redis://:RedisSecret_2026!@redis:6379/2

# ===========================================
# JWT CONFIGURATION (Auth Service)
# ===========================================
JWT_SECRET=super-secret-jwt-key-change-in-production-2026
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ===========================================
# SERVICIOS - PUERTOS Y URLs
# ===========================================
AUTH_SERVICE_PORT=3004
AUTH_SERVICE_URL=http://auth-service:3004

USER_SERVICE_PORT=3001
USER_SERVICE_URL=http://user-service:3001

PROJECT_SERVICE_PORT=3002
PROJECT_SERVICE_URL=http://project-service:3002

GRAPHQL_API_PORT=4000
GRAPHQL_API_URL=http://graphql-api:4000

API_GATEWAY_PORT=8080
API_GATEWAY_URL=http://api-gateway:8080

NGINX_PORT=80

# ===========================================
# RATE LIMITING (API Gateway)
# ===========================================
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# ===========================================
# GRAPHQL API
# ===========================================
INTROSPECTION_ENABLED=true
PLAYGROUND_ENABLED=true

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info
NODE_ENV=production

# ===========================================
# TRUST PROXY (Servicios internos)
# ===========================================
TRUST_PROXY=true
